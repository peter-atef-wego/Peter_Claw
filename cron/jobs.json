{
  "version": 1,
  "jobs": [
    {
      "id": "memory_s3_backup",
      "name": "memory_s3_backup",
      "schedule": {
        "kind": "cron",
        "expr": "0 23 * * *"
      },
      "enabled": true,
      "wakeMode": "now",
      "sessionTarget": "main",
      "delivery": {
        "mode": "none"
      },
      "command": "python3 /home/openclaw/.openclaw/workspace/scripts/memory_backup/backup_memory.py",
      "timeout_s": 600,
      "state": {}
    },
    {
      "id": "lessons_distil",
      "name": "lessons_distil",
      "schedule": {
        "kind": "cron",
        "expr": "30 23 * * *"
      },
      "enabled": true,
      "wakeMode": "now",
      "sessionTarget": "main",
      "delivery": {
        "mode": "none"
      },
      "command": "python3 /home/openclaw/.openclaw/workspace/scripts/report_store/lessons.py",
      "timeout_s": 120,
      "state": {}
    },
    {
      "id": "openclaw_nova_mirror",
