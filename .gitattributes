# Normalise line endings so a Windows checkout does not rewrite every file.
* text=auto eol=lf

*.py   text eol=lf diff=python
*.sh   text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.jsonl text eol=lf

# Binary — never diff or merge these.
*.png  binary
*.jpg  binary
*.pdf  binary
*.xz   binary
*.gz   binary
*.zip  binary

# Append-only telemetry and rendered log markdown: keep them out of diff review
# and let git take ours on conflict rather than producing conflict markers inside
# a JSONL stream.
memory/knowledge/session_analytics.jsonl -diff merge=union
memory/logs/netsuite-mcp/*.md            -diff
