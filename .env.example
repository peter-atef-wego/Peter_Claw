# .env.example - Confluence-GitHub Sync Agent
# Copy to .env and fill in values. Never commit .env.

# --- Atlassian (Confluence + Jira share one API token) -------------------------
ATLASSIAN_EMAIL=peter.atef@wego.com
ATLASSIAN_API_TOKEN=...                  # https://id.atlassian.com/manage-profile/security/api-tokens

# --- Confluence -----------------------------------------------------------------
CONFLUENCE_URL=https://example.atlassian.net/wiki
CONFLUENCE_SPACE_ID=...
CONFLUENCE_PARENT_PAGE_ID=...            # confluence-branch-docs: parent for [Branch Docs] pages
AI_AUTOMATION_2026_FOLDER_ID=...         # jira-confluence-documentation-sync: AI & Automation 2026 folder

# --- Jira (read-only, used to initialize process pages) ------------------------
JIRA_URL=https://example.atlassian.net
JIRA_EMAIL=peter.atef@wego.com

# --- GitHub (read-only) --------------------------------------------------------
GITHUB_REPOSITORY=owner/repo
GITHUB_TOKEN=...                         # fine-grained PAT, contents:read
