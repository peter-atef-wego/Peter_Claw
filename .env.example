# .env.example — openclaw-nova Environment Variables
# Copy to .env and fill in values. Never commit .env to git.
# Secrets are stored in WegoClaw (OpenClaw secrets manager) for production use.

# ─── LLM Providers ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Communication ────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# ─── Atlassian (Jira + Confluence) ────────────────────────────────────────────
JIRA_EMAIL=peter.atef@wego.com
JIRA_API_TOKEN=                          # Add to WegoClaw — currently pending
CONFLUENCE_URL=https://wegomushi.atlassian.net/wiki

# ─── GitHub ───────────────────────────────────────────────────────────────────
GITHUB_TOKEN_V4=github_pat_...              # Fine-grained PAT scoped to peter-atef-wego org

# ─── Data (Google Cloud / BigQuery) ───────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=wego-prod
BQ_SERVICE_ACCOUNT_PATH=/path/to/service-account.json

# ─── Fireflies ────────────────────────────────────────────────────────────────
FIREFLIES_API_KEY=

# ─── Domain-Specific ──────────────────────────────────────────────────────────
NETSUITE_ACCOUNT_ID=                     # NetSuite account ID for API access
